{
  "name": "living-meadow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/inline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node scripts/verify-browser.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/three": "0.180.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "tsx": "^4.20.6",
    "playwright": "^1.56.0"
  }
}
